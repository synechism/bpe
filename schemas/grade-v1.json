{
  "$defs": {
    "Outcome": {
      "enum": [
        "pass",
        "fail",
        "timeout",
        "skipped",
        "infra_error",
        "unsupported"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Stage": {
      "enum": [
        "ingest",
        "compile",
        "object_policy",
        "verifier",
        "functional",
        "semantics"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Benchmark Score"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "comparable": {
      "title": "Comparable",
      "type": "boolean"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "failure_reason": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Reason"
    },
    "first_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stage"
        },
        {
          "type": "null"
        }
      ]
    },
    "grader_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grader Id",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "bpe.grade.v1",
      "default": "bpe.grade.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_outcomes": {
      "additionalProperties": {
        "$ref": "#/$defs/Outcome"
      },
      "propertyNames": {
        "$ref": "#/$defs/Stage"
      },
      "title": "Stage Outcomes",
      "type": "object"
    },
    "strict_success": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Strict Success"
    },
    "task_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "training_reward": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Training Reward"
    }
  },
  "required": [
    "policy_id",
    "grader_id",
    "task_id",
    "candidate_sha256",
    "evidence_sha256",
    "contract_sha256",
    "comparable",
    "strict_success",
    "benchmark_score",
    "training_reward",
    "first_failure",
    "failure_reason",
    "stage_outcomes"
  ],
  "title": "Grade",
  "type": "object"
}
