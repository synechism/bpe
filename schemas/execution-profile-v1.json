{
  "$defs": {
    "EnvironmentFingerprint": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
          "title": "Architecture",
          "type": "string"
        },
        "bpfix_commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bpfix Commit"
        },
        "clang_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Clang Sha256",
          "type": "string"
        },
        "clang_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Clang Version",
          "type": "string"
        },
        "compile_recipe_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Compile Recipe Sha256",
          "type": "string"
        },
        "environment_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
          "title": "Environment Id",
          "type": "string"
        },
        "isolation": {
          "$ref": "#/$defs/Isolation"
        },
        "kernel_btf_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Btf Sha256",
          "type": "string"
        },
        "kernel_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Config Sha256",
          "type": "string"
        },
        "kernel_image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Image Sha256",
          "type": "string"
        },
        "kernel_release": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Kernel Release",
          "type": "string"
        },
        "libbpf_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Libbpf Commit",
          "type": "string"
        },
        "libbpf_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Libbpf Version",
          "type": "string"
        },
        "normalizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Normalizer Sha256",
          "type": "string"
        },
        "normalizer_version": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
          "title": "Normalizer Version",
          "type": "string"
        },
        "public_sdk_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Sdk Sha256",
          "type": "string"
        },
        "resource_limits_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resource Limits Sha256",
          "type": "string"
        },
        "rootfs_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rootfs Sha256",
          "type": "string"
        },
        "runner_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runner Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "bpe.environment.v1",
          "default": "bpe.environment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Sha256"
        }
      },
      "required": [
        "environment_id",
        "isolation",
        "architecture",
        "kernel_release",
        "kernel_image_sha256",
        "kernel_config_sha256",
        "kernel_btf_sha256",
        "rootfs_sha256",
        "clang_version",
        "clang_sha256",
        "libbpf_version",
        "libbpf_commit",
        "runner_sha256",
        "compile_recipe_sha256",
        "normalizer_version",
        "normalizer_sha256",
        "public_sdk_sha256",
        "resource_limits_sha256"
      ],
      "title": "EnvironmentFingerprint",
      "type": "object"
    },
    "ExecutionResourceProfile": {
      "additionalProperties": false,
      "description": "Typed process and filesystem ceilings; no opaque command or environment surface.",
      "properties": {
        "core_dumps_enabled": {
          "const": false,
          "title": "Core Dumps Enabled",
          "type": "boolean"
        },
        "cpu_time_seconds": {
          "maximum": 600,
          "minimum": 1,
          "title": "Cpu Time Seconds",
          "type": "integer"
        },
        "file_size_bytes": {
          "maximum": 1073741824,
          "minimum": 1024,
          "title": "File Size Bytes",
          "type": "integer"
        },
        "memory_bytes": {
          "maximum": 68719476736,
          "minimum": 67108864,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "network_enabled": {
          "const": false,
          "title": "Network Enabled",
          "type": "boolean"
        },
        "open_files_max": {
          "maximum": 65536,
          "minimum": 8,
          "title": "Open Files Max",
          "type": "integer"
        },
        "pids_max": {
          "maximum": 4096,
          "minimum": 1,
          "title": "Pids Max",
          "type": "integer"
        },
        "profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "schema_version": {
          "const": "bpe.execution-resource-profile.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "stack_bytes": {
          "maximum": 67108864,
          "minimum": 65536,
          "title": "Stack Bytes",
          "type": "integer"
        },
        "stderr_bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Stderr Bytes",
          "type": "integer"
        },
        "stdout_bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Stdout Bytes",
          "type": "integer"
        },
        "swap_bytes": {
          "const": 0,
          "title": "Swap Bytes",
          "type": "integer"
        },
        "tmpfs_bytes": {
          "maximum": 17179869184,
          "minimum": 1048576,
          "title": "Tmpfs Bytes",
          "type": "integer"
        },
        "tmpfs_inodes": {
          "maximum": 1000000,
          "minimum": 16,
          "title": "Tmpfs Inodes",
          "type": "integer"
        },
        "wall_timeout_ms": {
          "maximum": 600000,
          "minimum": 100,
          "title": "Wall Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "wall_timeout_ms",
        "cpu_time_seconds",
        "memory_bytes",
        "swap_bytes",
        "pids_max",
        "open_files_max",
        "file_size_bytes",
        "stack_bytes",
        "stdout_bytes",
        "stderr_bytes",
        "tmpfs_bytes",
        "tmpfs_inodes",
        "network_enabled",
        "core_dumps_enabled"
      ],
      "title": "ExecutionResourceProfile",
      "type": "object"
    },
    "Isolation": {
      "enum": [
        "microvm",
        "native_linux",
        "synthetic"
      ],
      "title": "Isolation",
      "type": "string"
    },
    "SnapshotComponents": {
      "additionalProperties": false,
      "description": "External snapshot resources that Firecracker does not authenticate as one unit.",
      "properties": {
        "block_device_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Block Device Config Sha256",
          "type": "string"
        },
        "kernel_btf_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Btf Sha256",
          "type": "string"
        },
        "kernel_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Config Sha256",
          "type": "string"
        },
        "kernel_image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Kernel Image Sha256",
          "type": "string"
        },
        "memory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Memory Sha256",
          "type": "string"
        },
        "rootfs_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rootfs Sha256",
          "type": "string"
        },
        "vm_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vm State Sha256",
          "type": "string"
        },
        "vsock_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vsock Config Sha256",
          "type": "string"
        }
      },
      "required": [
        "vm_state_sha256",
        "memory_sha256",
        "kernel_image_sha256",
        "kernel_config_sha256",
        "kernel_btf_sha256",
        "rootfs_sha256",
        "block_device_config_sha256",
        "vsock_config_sha256"
      ],
      "title": "SnapshotComponents",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Declarative microVM identity for admission; execution remains disabled in v1.",
  "properties": {
    "authoritative_ready": {
      "const": false,
      "title": "Authoritative Ready",
      "type": "boolean"
    },
    "cpu_features": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Cpu Features",
      "type": "array"
    },
    "cpu_model": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Cpu Model",
      "type": "string"
    },
    "cpu_template": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cpu Template"
    },
    "cpu_vendor": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Cpu Vendor",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentFingerprint"
    },
    "environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "execution_implemented": {
      "const": false,
      "title": "Execution Implemented",
      "type": "boolean"
    },
    "firecracker_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Firecracker Sha256",
      "type": "string"
    },
    "firecracker_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Firecracker Version",
      "type": "string"
    },
    "guest_agent_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Guest Agent Sha256",
      "type": "string"
    },
    "host_architecture": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Host Architecture",
      "type": "string"
    },
    "host_kernel_release": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Host Kernel Release",
      "type": "string"
    },
    "host_kernel_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Host Kernel Sha256",
      "type": "string"
    },
    "jailer_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Jailer Config Sha256",
      "type": "string"
    },
    "jailer_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Jailer Sha256",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Profile Id",
      "type": "string"
    },
    "resource_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resource Profile Sha256",
      "type": "string"
    },
    "resources": {
      "$ref": "#/$defs/ExecutionResourceProfile"
    },
    "schema_version": {
      "const": "bpe.execution-profile.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seccomp_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Seccomp Policy Sha256",
      "type": "string"
    },
    "smt_enabled": {
      "const": false,
      "title": "Smt Enabled",
      "type": "boolean"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotComponents"
    },
    "snapshot_compatibility_profile": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Snapshot Compatibility Profile",
      "type": "string"
    },
    "snapshot_components_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Components Sha256",
      "type": "string"
    },
    "vcpu_count": {
      "const": 1,
      "title": "Vcpu Count",
      "type": "integer"
    },
    "worker_pool_audience": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Worker Pool Audience",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "worker_pool_audience",
    "environment",
    "environment_sha256",
    "resources",
    "resource_profile_sha256",
    "firecracker_version",
    "firecracker_sha256",
    "jailer_sha256",
    "guest_agent_sha256",
    "seccomp_policy_sha256",
    "jailer_config_sha256",
    "snapshot",
    "snapshot_components_sha256",
    "host_kernel_release",
    "host_kernel_sha256",
    "host_architecture",
    "vcpu_count",
    "smt_enabled",
    "cpu_vendor",
    "cpu_model",
    "cpu_features",
    "snapshot_compatibility_profile",
    "execution_implemented",
    "authoritative_ready"
  ],
  "title": "ExecutionProfile",
  "type": "object"
}
