    "profile_id",
    "wall_timeout_ms",
    "cpu_time_seconds",
    "memory_bytes",
    "swap_bytes",
    "pids_max",
    "open_files_max",
    "file_size_bytes",
    "stack_bytes",
    "stdout_bytes",
    "stderr_bytes",
    "tmpfs_bytes",
    "tmpfs_inodes",
    "network_enabled",
    "core_dumps_enabled"
