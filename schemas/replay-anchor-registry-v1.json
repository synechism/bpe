    "registry_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/@:+-]{0,127}$",
      "title": "Registry Id",
      "type": "string"
    },
    "schema_version": {
      "const": "bpe.replay-anchor-registry.v1",
      "default": "bpe.replay-anchor-registry.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "registry_id",
    "issuer",
    "experiment_manifest_sha256",
    "anchors"
