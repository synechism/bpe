          "title": "Contract Sha256",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "grade_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Grade Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "evidence_sha256",
        "grade_sha256",
        "contract_sha256",
        "policy_sha256"
